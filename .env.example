# ============================================================
#  Claude-Lens — Backend environment configuration
# ------------------------------------------------------------
#  Copy this file to `.env` and fill in your values:
#      cp .env.example .env
#
#  Heads-up: the secrets below (MongoDB URI, Cloudflare R2,
#  Groq) can ALSO be configured at runtime from the Setup UI
#  (POST /api/v1/setup/*). If you go that route they are stored
#  in ~/.claude-lens/config.json and you can leave them blank
#  here. See the README "Environment Variables" section.
# ============================================================

# Node environment: development | production
NODE_ENV=development

# Port for the HTTP + WebSocket server.
# The frontend connects to  ws://localhost:<PORT>/ws
PORT=20261

# ------------------------------------------------------------
#  MongoDB  (sessions, messages, tasks, memories are synced here)
# ------------------------------------------------------------
# Atlas : mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
# Local : mongodb://localhost:27017/claude-lens
# Free Atlas cluster: https://www.mongodb.com/cloud/atlas/register
# Tip: leave blank to start in "setup mode" and configure it from the Setup UI.
MONGO_URI=

# Backend base URL — used to build magic links
BACKEND_URL=http://localhost:20261

# Frontend origin (your Next.js app — used for CORS / magic links)
FRONTEND_URL=http://localhost:3000

# App version (stamped into export manifests)
APP_VERSION=1.0.0

# ------------------------------------------------------------
#  Optional — Voice input (Speech-to-Text)
# ------------------------------------------------------------
# Groq API key. Powers Whisper transcription + LLaMA rephrase for voice messages.
# Free key: https://console.groq.com  →  API Keys   (starts with "gsk_")
# Optional: can also be set from the Setup UI.
GROQ_API_KEY=

# ------------------------------------------------------------
#  Optional — Cloudflare R2 (attachments + JSONL session backups)
# ------------------------------------------------------------
# S3-compatible storage for image/file attachments and session JSONL backups.
# Create a bucket + API token: https://dash.cloudflare.com  →  R2
# Optional: can also be set from the Setup UI.
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_PUBLIC_URL=https://<public-bucket-id>.r2.dev
CLOUDFLARE_R2_BUCKET_NAME=claude-lens
